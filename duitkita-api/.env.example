# App
APP_ENV=development
APP_PORT=8080

# Database
# Running via `go run` on the host: use localhost.
# Running via docker-compose (this service only, DB/Redis are separate
# containers that publish their ports to the host): use host.docker.internal.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=duitkita
DB_SSLMODE=disable

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# Google Cloud Storage
# Set to false to skip GCS entirely (e.g. testing the DB connection locally
# without credentials) — avatar upload and report export download will
# return a clear "storage is disabled" error instead of crashing at startup.
GCS_ENABLED=false
GCS_BUCKET_NAME=duitkita-storage
GCS_CREDENTIALS_FILE=./gcs-service-account.json

# Retention (cleanup job runs daily at 03:00, see worker/cleanup_job.go)
# security-audit is kept much longer than the rest since it may be needed
# for compliance — confirm your own retention policy before relying on this.
RETENTION_SESSION_DAYS=30
RETENTION_NOTIFICATION_DAYS=90
RETENTION_ACTIVITY_DAYS=180
RETENTION_SECURITY_AUDIT_DAYS=365

# Features
# Forecast/health-score are heuristic-only (no settled formula yet) — set
# to false to hide GET /reports/forecast and /reports/health-score without
# touching the rest of the reports.
FEATURE_INSIGHTS_ENABLED=true

# Logger
LOG_LEVEL=debug
