PORT=3001
NODE_ENV=development

DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:PORT/DATABASE_NAME
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=30d

# Supabase Storage
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Driver: local (dev) | supabase (production)

# Report PDF storage
REPORT_STORAGE_DRIVER=supabase
REPORT_EXPORT_DIR=./storage/exports
REPORT_EXPORT_TTL_DAYS=7
SUPABASE_EXPORT_BUCKET=report-exports

# Profile avatar storage
AVATAR_STORAGE_DRIVER=supabase
AVATAR_STORAGE_DIR=./storage/avatars
SUPABASE_AVATAR_BUCKET=avatars
