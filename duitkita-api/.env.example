# App
APP_ENV=development
APP_PORT=8080

# Database
# Running via `go run` on the host: use localhost.
# Running via docker-compose (this service only, DB/Redis are separate
# containers that publish their ports to the host): use host.docker.internal.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=duitkita
DB_SSLMODE=disable

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# Google Cloud Storage
GCS_BUCKET_NAME=duitkita-storage
GCS_CREDENTIALS_FILE=./gcs-service-account.json

# Logger
LOG_LEVEL=debug
