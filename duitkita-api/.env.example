# App
APP_ENV=development
APP_PORT=8080

# Database
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=duitkita
DB_SSLMODE=disable

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_SECRET_PREVIOUS=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# Google Cloud Storage
GCS_ENABLED=false
GCS_BUCKET_NAME=duitkita-storage
GCS_CREDENTIALS_FILE=./gcs-service-account.json

# Redis (Upstash in production — requires TLS; plain local Docker redis for
# dev can leave REDIS_TLS_ENABLED=false)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS_ENABLED=false

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# CORS (semicolon-delimited — see the comment on getEnvAsSlice in config.go)
CORS_ALLOWED_ORIGINS=http://localhost:5173;http://localhost:3000

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-project-email@gmail.com
SMTP_APP_PASSWORD=change-me-gmail-app-password
SMTP_FROM_NAME=DuitKita

# OTP
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Internal jobs
# Generate with: openssl rand -hex 32
INTERNAL_JOBS_SECRET=change-me-long-random-secret

# Cloud Tasks
# Leave disabled for local dev — exports render inline in a goroutine
CLOUD_TASKS_ENABLED=false
CLOUD_TASKS_PROJECT_ID=your-gcp-project-id
CLOUD_TASKS_LOCATION_ID=asia-southeast2
CLOUD_TASKS_QUEUE_ID=report-exports-queue
# Base URL of the deployed Cloud Run service, no trailing slash, e.g.
# https://duitkita-api-xxxxx.run.app
CLOUD_TASKS_TARGET_BASE_URL=

# Retention
RETENTION_SESSION_DAYS=30
RETENTION_NOTIFICATION_DAYS=90
RETENTION_ACTIVITY_DAYS=180
RETENTION_SECURITY_AUDIT_DAYS=365

# Features
FEATURE_INSIGHTS_ENABLED=true

# Logger
LOG_LEVEL=debug
