PORT=3001
NODE_ENV=development

DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:PORT/DATABASE_NAME
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=30d

# Storage Driver: local (dev) | supabase (production) | gcs (production)
REPORT_STORAGE_DRIVER=gcs
AVATAR_STORAGE_DRIVER=gcs

# --- Supabase Storage (used when driver=supabase) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_EXPORT_BUCKET=report-exports
SUPABASE_AVATAR_BUCKET=avatars

# --- GCP Cloud Storage (used when driver=gcs) ---
# On Cloud Run: leave GCS_KEYFILE empty (ADC auto-authenticates via service account)
# For local dev: set GCS_KEYFILE to service account JSON path, or run `gcloud auth application-default login`
GCS_PROJECT_ID=your-gcp-project-id
GCS_KEYFILE=
GCS_AVATAR_BUCKET=duitkita-avatars
GCS_EXPORT_BUCKET=duitkita-report-exports

# --- Local filesystem (used when driver=local) ---
REPORT_EXPORT_DIR=./storage/exports
AVATAR_STORAGE_DIR=./storage/avatars

# Report export settings
REPORT_EXPORT_TTL_DAYS=7
